// ---------------------------------------------------------------------------
// game.hxlsl — game VS entry (VSMain), classic HLSL source for fxc (SDK
// 10.0.26100.0 fxc, target /T vs_5_0). No sRGB conversions in this shader.
//
// Inputs (engine input layout — exact array in docs/shaders.md, generated
// header build/layout_gen.hpp):
//   POSITION float3, NORMAL float3, TEXCOORD float2, COLOR float4 (stride 44)
// Semantic spelling (must match engine layout array exactly; D3D10/D3DX-style
// canonical encoding verified in generated bytecode):
//   in : POSITION NORMAL TEXCOORD0 COLOR0   out: SV_POSITION + TEXCOORD1..3
// ---------------------------------------------------------------------------

cbuffer Matrices : register(b0)
{
    float4x4 World      : packoffset(c0);
    float4x4 View       : packoffset(c4);
    float4x4 Projection : packoffset(c8);
};

// row-column idiom (DirectXMath-convention data, standard mul(v, M)):
//   mul(v, mul(mul(World, View), Projection))
float4 VSMain(float4 pos      : POSITION,
             float3 normal    : NORMAL,
             float2 texcoord  : TEXCOORD0,
             float4 color     : COLOR0) : SV_POSITION
{
    float4 hv = mul(pos, mul(mul(World, View), Projection));

    float4 o : SV_POSITION;
    float3 wn : NORMAL;    // world-space, passed to PS (canonical PN/TV slots)
    float2 uv : TEXCOORD1;
    float4 col : COLOR0;

    o.pos = hv;
    o.normal = mul(normal, (float3x3)World);  // canonical TEXCOORD1
    o.uv = texcoord;                          // canonical TEXCOORD2
    o.color = color;                          // canonical TEXCOORD3
    return o;
}
